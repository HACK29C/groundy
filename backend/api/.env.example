# Groundy API — variables de entorno (copia a .env y completa; .env NO va al repo)

# Google Earth Engine (obligatoria para los endpoints de analisis)
GEE_KEY_PATH=secrets/gee_key.json

# Supabase (OPCIONALES: si faltan, el API funciona en vivo sin cache)
SUPABASE_URL=https://svaksbawrhndxyzugjjr.supabase.co
SUPABASE_SERVICE_KEY=   # service_role (SECRETA, solo en el servidor; nunca en el repo ni en el front)

# Cache (opcionales, con valores por defecto)
CACHE_TABLE=analysis_cache
CACHE_TTL_DAYS=30
CACHE_COORD_DECIMALS=4
PROC_VERSION=1.2

# CORS: dominios autorizados separados por coma; '*' en desarrollo
CORS_ORIGINS=*
